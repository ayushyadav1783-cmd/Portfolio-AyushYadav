---
// Resume viewer (spec §8.1). Opened by any [data-resume] link; /resume.pdf is the no-JS fallback.
import { content, copy } from '../content';
const s = copy.scouting;
const person = content.person;
const edu = person.education[0];
const exp = person.experience[0];
---

<div class="var-stripe" aria-hidden="true" data-var-stripe>
  <span class="m">{s.stripe}</span><span class="m">{s.stripe}</span><span class="m">{s.stripe}</span>
</div>

<dialog class="scout" aria-labelledby="scout-h" data-scout data-lenis-prevent>
  <div class="scout__sheet" data-scout-sheet>
    <span class="scout__scan" aria-hidden="true" data-scout-scan></span>
    <header class="scout__head">
      <div>
        <p class="scout__kicker m">{s.kicker}</p>
        <h2 id="scout-h" class="scout__title d">{s.title}</h2>
        <p class="scout__sub m">{s.sub}</p>
      </div>
      <button type="button" class="scout__x" aria-label={s.close} data-scout-close>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6 6 18"></path></svg>
      </button>
    </header>

    <div class="scout__body">
      <div class="scout__frame-wrap" data-scout-frame-wrap>
        <iframe class="scout__frame" title={s.frameTitle} data-scout-frame></iframe>
      </div>
      <dl class="scout__card" data-scout-card>
        <dt class="m">POSITION</dt><dd>{person.headline}</dd>
        <dt class="m">CURRENT CLUB</dt><dd>{edu.degree}, {edu.school} · GPA {edu.gpa} · {edu.dates}</dd>
        <dt class="m">ON LOAN AT</dt><dd>{exp.role}, {exp.org} · {exp.dates}</dd>
        <dt class="m">HOME GROUND</dt><dd>{person.location}</dd>
      </dl>
      <p class="scout__stamp d" aria-hidden="true" data-scout-stamp>{s.stamp}</p>
    </div>

    <footer class="scout__actions">
      <a href={person.resume} download="Ayush_Yadav_Resume.pdf" class="btn btn--gold">{s.download}</a>
      <a href={person.resume} target="_blank" rel="noopener" class="btn btn--ghost">{s.open}</a>
      <button type="button" class="scout__back" data-scout-close>{s.close}</button>
    </footer>
  </div>
</dialog>

<style>
  .var-stripe {
    position: fixed; left: -20vw; right: -20vw; top: 50%; z-index: 80; height: 84px; margin-top: -42px;
    display: flex; align-items: center; justify-content: center; gap: 48px;
    background: var(--red-card); color: var(--on-red); transform: rotate(-6deg) translateX(-130%);
    font-size: 15px; font-weight: 700; letter-spacing: .3em; white-space: nowrap;
    pointer-events: none; visibility: hidden;
  }

  .scout {
    width: min(1040px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 32px);
    margin: auto; padding: 0; border: 0; background: transparent; color: var(--floodlight); overflow: visible;
  }
  .scout::backdrop { background: rgba(8, 8, 11, .9); backdrop-filter: blur(8px); }
  .scout__sheet {
    position: relative; display: flex; flex-direction: column; max-height: calc(100dvh - 32px);
    padding: clamp(20px, 3vw, 36px); border-radius: var(--r-panel); background: var(--stand); overflow: hidden;
    box-shadow: 0 0 0 1px rgba(245, 197, 66, .4), 0 40px 100px rgba(0, 0, 0, .6);
    transform-origin: 50% 100%;
  }
  .scout__scan {
    position: absolute; left: 0; right: 0; top: 0; height: 3px; z-index: 3; pointer-events: none; opacity: 0;
    background: var(--trophy); box-shadow: 0 0 24px 6px rgba(245, 197, 66, .45);
  }
  .scout__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .scout__kicker { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .14em; color: var(--red-card); }
  .scout__title { margin: 8px 0 0; font-weight: 900; font-size: clamp(40px, 6vw, 72px); line-height: .9; }
  .scout__sub { margin: 8px 0 0; font-size: 12px; letter-spacing: .14em; color: var(--muted); }
  .scout__x {
    flex: none; width: 48px; height: 48px; border-radius: var(--r-pill); border: 1px solid var(--control);
    background: transparent; color: var(--floodlight); cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  }
  .scout__x:hover { border-color: var(--trophy); color: var(--trophy); }

  .scout__body { position: relative; margin-top: 20px; min-height: 0; flex: 1; }
  .scout__frame-wrap { height: min(68dvh, 820px); border-radius: 16px; overflow: hidden; background: var(--floodlight); }
  .scout__frame { width: 100%; height: 100%; border: 0; display: block; }
  .scout__card {
    display: none; margin: 0; padding: 20px; border-radius: 16px; background: var(--tunnel);
    grid-template-columns: auto 1fr; gap: 12px 18px; font-size: 15px; line-height: 22px;
  }
  .scout__card dt { font-size: 11px; line-height: 22px; letter-spacing: .14em; color: var(--muted); }
  .scout__card dd { margin: 0; }
  /* Touch: summary card instead of an inline PDF. */
  .scout.is-touch .scout__frame-wrap { display: none; }
  .scout.is-touch .scout__card { display: grid; }

  .scout__stamp {
    position: absolute; right: clamp(12px, 3vw, 32px); top: clamp(12px, 3vw, 28px); z-index: 2; margin: 0;
    padding: 6px 14px; border: 4px solid var(--red-card); border-radius: 8px; color: var(--red-card);
    font-weight: 900; font-size: clamp(28px, 4vw, 44px); line-height: 1; letter-spacing: .04em;
    background: rgba(8, 8, 11, .82); transform: rotate(-12deg); pointer-events: none;
  }
  .scout.is-touch .scout__stamp { top: auto; bottom: -18px; right: 10px; font-size: 26px; }
  .scout__actions { margin-top: 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .scout__back {
    min-height: 44px; padding: 0 6px; border: 0; background: transparent; color: var(--muted);
    font: 500 14px var(--font-body); text-decoration: underline; cursor: pointer;
  }
  .scout__back:hover { color: var(--floodlight); }
</style>
