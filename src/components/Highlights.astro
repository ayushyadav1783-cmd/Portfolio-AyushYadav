---
// Recruiter escape hatch (spec §8, board 04). Opened by the red pill (#highlights).
import { content, copy, resumeUrl } from '../content';
const h = copy.highlights;
const person = content.person;
---

<div class="replay" aria-hidden="true" data-replay><span class="m">▶ REPLAY</span><span class="m">▶ REPLAY</span><span class="m">▶ REPLAY</span></div>

<dialog id="match-highlights" class="hl" aria-labelledby="hl-h" data-hl data-lenis-prevent>
  <div class="hl__panel" data-hl-panel>
    <div class="hl__head">
      <div>
        <p class="hl__kicker m">{h.kicker}</p>
        <h2 id="hl-h" class="hl__title d">{h.title}</h2>
      </div>
      <button type="button" class="hl__x" aria-label="Close highlights" data-hl-close>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6 6 18"></path></svg>
      </button>
    </div>

    <p class="hl__summary" data-hl-item><strong>{h.summaryName}</strong> {h.summary} <span class="gold">{h.summaryGold}</span></p>

    <dl class="hl__stats" data-hl-item>
      {content.highlights.stats.map(([v, l]) => (
        <div class="hl__stat"><dt class="m">{l}</dt><dd class="m">{v}</dd></div>
      ))}
    </dl>

    <p class="hl__label m" data-hl-item>TOP 3 GOALS</p>
    <ol class="hl__goals" data-hl-item>
      {content.highlights.top3.map(([t, d], i) => (
        <li><span class="hl__n d">{String(i + 1).padStart(2, '0')}</span><span><strong>{t}.</strong> <span class="muted">{d}</span></span></li>
      ))}
    </ol>

    <p class="hl__stack" data-hl-item><span class="m">STACK </span> {h.stack}</p>

    <div class="hl__actions" data-hl-item>
      <a href={resumeUrl} download="Ayush_Yadav_Resume.pdf" class="btn btn--gold">Download resume</a>
      <a href={`mailto:${person.email}`} class="btn btn--ghost">{person.email}</a>
      <a href={person.linkedin} class="btn btn--ghost" rel="me noopener">LinkedIn</a>
    </div>
    <button type="button" class="hl__exit" data-hl-close data-hl-item>{h.exit}</button>
  </div>
</dialog>

<style>
  .replay {
    position: fixed; left: -20vw; right: -20vw; top: 50%; z-index: 80; height: 96px; margin-top: -48px;
    display: flex; align-items: center; justify-content: center; gap: 64px;
    background: var(--red-card); color: var(--on-red); transform: rotate(-4deg) translateX(-130%);
    font-size: 16px; font-weight: 700; letter-spacing: .3em; white-space: nowrap; pointer-events: none; visibility: hidden;
  }

  .hl {
    width: min(1080px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 32px);
    margin: auto; padding: 0; border: 0; background: transparent; color: var(--floodlight); overflow: visible;
  }
  .hl::backdrop { background: rgba(8, 8, 11, .9); backdrop-filter: blur(8px); }
  .hl__panel {
    max-height: calc(100dvh - 32px); overflow-y: auto; overscroll-behavior: contain;
    padding: clamp(24px, 4vw, 48px); border-radius: var(--r-panel); background: var(--stand);
    box-shadow: 0 0 0 1px rgba(245, 197, 66, .4), 0 40px 100px rgba(0, 0, 0, .6);
  }
  .hl__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .hl__kicker { margin: 0; font-size: 12px; letter-spacing: .14em; color: var(--red-card); font-weight: 700; }
  .hl__title { margin: 10px 0 0; font-weight: 900; font-size: clamp(44px, 6vw, 72px); line-height: .9; }
  .hl__x {
    flex: none; width: 48px; height: 48px; border-radius: var(--r-pill); border: 1px solid var(--control);
    background: transparent; color: var(--floodlight); cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  }
  .hl__x:hover { border-color: var(--trophy); color: var(--trophy); }
  .hl__summary { margin: 20px 0 0; font-size: 18px; line-height: 1.55; max-width: 820px; }
  .hl__stats { margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  @media (max-width: 520px) { .hl__stats { grid-template-columns: 1fr 1fr; } }
  .hl__stat { padding: 16px; border-radius: 16px; background: var(--tunnel); display: flex; flex-direction: column-reverse; gap: 6px; }
  .hl__stat dd { margin: 0; font-size: 24px; font-weight: 700; color: var(--trophy); white-space: nowrap; }
  .hl__stat dt { font-size: 10px; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; }
  .hl__label { margin: 28px 0 10px; font-size: 11px; letter-spacing: .14em; color: var(--muted); }
  .hl__goals { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .hl__goals li { display: flex; gap: 16px; align-items: baseline; padding: 14px 16px; border-radius: 14px; border: 1px solid rgba(246, 243, 236, .1); font-size: 16px; line-height: 24px; }
  .hl__n { font-weight: 900; font-size: 28px; color: var(--trophy); }
  .hl__stack { margin: 20px 0 0; font-size: 15px; line-height: 24px; color: var(--muted); }
  .hl__stack .m { font-size: 11px; letter-spacing: .14em; }
  .hl__actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px; }
  .hl__exit {
    margin-top: 20px; min-height: 44px; padding: 0; border: 0; background: transparent; color: var(--muted);
    font: 500 14px var(--font-body); cursor: pointer; text-decoration: underline;
  }
  .hl__exit:hover { color: var(--floodlight); }
</style>
