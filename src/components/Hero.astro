---
import { copy, resumeUrl } from '../content';
const h = copy.hero;

// Deterministic starfield, same seeded generator as the design board.
function rand(seed: number) {
  let s = seed;
  return () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };
}
const r = rand(7);
const stars = Array.from({ length: 130 }, () => ({
  x: (r() * 100).toFixed(2),
  y: (r() * 62).toFixed(2),
  size: r() < .86 ? 1 : 2,
  o: (.25 + r() * .7).toFixed(2),
  tw: r() < .3,
  d: (r() * 3.6).toFixed(1),
}));
---

<section id="top" class="hero" aria-labelledby="hero-name" data-hero>
  <div class="hero__sky" aria-hidden="true">
    {stars.map((s) => (
      <span
        class:list={['star', { tw: s.tw }]}
        style={`left:${s.x}%;top:${s.y}%;width:${s.size}px;height:${s.size}px;opacity:${s.o};animation-delay:${s.d}s`}
      ></span>
    ))}
  </div>
  <div class="hero__planet" aria-hidden="true" data-planet></div>
  <div class="hero__ring" aria-hidden="true" data-planet-ring></div>
  <div class="hero__beam hero__beam--l" aria-hidden="true" data-beam></div>
  <div class="hero__beam hero__beam--r" aria-hidden="true" data-beam></div>
  {['l', 'r'].map((side) => (
    <div class:list={['tower', `tower--${side}`]} aria-hidden="true">
      <div class="tower__lamps">{Array.from({ length: 8 }, () => <span></span>)}</div>
      <div class="tower__mast"></div>
    </div>
  ))}
  <div class="hero__stands" aria-hidden="true" data-stands></div>
  <div class="hero__tunnel" aria-hidden="true"></div>

  <div class="hero__words wrap" data-hero-words>
    <p class="hero__eyebrow m" data-walk-fade>{h.eyebrow}</p>
    <h1 id="hero-name" class="hero__name d" data-walk-name>
      <span class="hero__first" data-intro-first>{h.first}</span><br /><span class="outline-text hero__last" data-intro-last>{h.last}</span><span class="red hero__stop" data-intro-stop>.</span>
    </h1>
    <p class="hero__tagline" data-walk-fade>{h.taglineA} <span class="gold">{h.taglineB}</span></p>
    <p class="hero__sub m" data-walk-fade>{h.sub}</p>
    <div class="hero__ctas" data-walk-fade>
      <a href="#warmup" class="btn btn--gold">
        {h.ctaPrimary}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="m6 13 6 6 6-6"></path></svg>
      </a>
      <a href={resumeUrl} class="btn btn--ghost" data-resume>{h.ctaSecondary}</a>
    </div>
  </div>
  <p class="hero__cue m" aria-hidden="true" data-walk-fade>{h.scrollCue}</p>
</section>

<div class="ticker" aria-hidden="true">
  <div class="marquee marquee--run d" data-velocity>
    <span>{h.ticker}</span><span>{h.ticker}</span>
  </div>
</div>

<style>
  .hero { position: relative; min-height: clamp(760px, 64cqi, 940px); overflow: hidden; }
  .hero__sky { position: absolute; inset: 0; }
  .star { position: absolute; border-radius: var(--r-pill); background: var(--floodlight); }
  .tw { animation: tw 3.6s ease-in-out infinite; }
  @keyframes tw { 0%, 100% { opacity: .2; } 50% { opacity: 1; } }

  .hero__planet {
    position: absolute; right: clamp(-60px, 6cqi, 120px); top: clamp(40px, 6cqi, 96px);
    width: clamp(160px, 20cqi, 290px); aspect-ratio: 1; border-radius: var(--r-pill);
    background: radial-gradient(circle at 34% 30%, #fff4cf 0%, #f5c542 22%, #c2410c 58%, #3a0d08 82%, #120405 100%);
    animation: glow 6s ease-in-out infinite;
  }
  @keyframes glow {
    0%, 100% { box-shadow: 0 0 80px 20px rgba(245, 197, 66, .28), 0 0 200px 60px rgba(255, 74, 61, .14); }
    50% { box-shadow: 0 0 110px 30px rgba(245, 197, 66, .36), 0 0 240px 80px rgba(255, 74, 61, .2); }
  }
  .hero__ring {
    position: absolute; right: clamp(-150px, -1cqi, 30px); top: clamp(110px, 13cqi, 200px);
    width: clamp(340px, 38cqi, 560px); height: clamp(48px, 5cqi, 80px);
    border: 2px solid rgba(245, 197, 66, .55); border-radius: 50%; transform: rotate(-14deg);
  }
  .hero__beam { position: absolute; top: 16%; width: 46%; height: 84%; }
  .hero__beam--l {
    left: 4%; background: linear-gradient(160deg, rgba(246, 243, 236, .22), rgba(246, 243, 236, 0) 62%);
    clip-path: polygon(0 0, 9% 0, 100% 100%, 38% 100%);
  }
  .hero__beam--r {
    right: 4%; background: linear-gradient(200deg, rgba(246, 243, 236, .22), rgba(246, 243, 236, 0) 62%);
    clip-path: polygon(91% 0, 100% 0, 62% 100%, 0 100%);
  }
  .tower { position: absolute; top: 15%; display: flex; flex-direction: column; align-items: center; }
  .tower--l { left: 4%; }
  .tower--r { right: 4%; }
  .tower__lamps {
    display: grid; grid-template-columns: repeat(4, 10px); gap: 4px; padding: 6px;
    background: var(--tunnel); border-radius: var(--r-chip); box-shadow: 0 0 40px 10px rgba(246, 243, 236, .35);
  }
  .tower__lamps span { height: 8px; background: #fffbe8; }
  .tower__mast { width: 4px; height: clamp(300px, 34cqi, 460px); background: var(--tunnel); }
  .hero__stands {
    position: absolute; left: -10%; right: -10%; bottom: -46%; height: 80%;
    border-radius: 50% 50% 0 0; background-color: #0d0d12; border-top: 2px solid rgba(246, 243, 236, .1);
    background-image: radial-gradient(circle, rgba(246, 243, 236, .16) 1px, transparent 1.6px); background-size: 9px 9px;
  }
  .hero__tunnel {
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
    width: clamp(140px, 16cqi, 220px); height: clamp(90px, 9cqi, 130px); border-radius: 110px 110px 0 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(246, 243, 236, .55), rgba(245, 197, 66, .12) 45%, #08080b 75%);
    border: 2px solid rgba(246, 243, 236, .14); border-bottom: 0;
  }

  .hero__words { position: relative; z-index: 2; padding-top: clamp(72px, 9cqi, 140px); }
  .hero__eyebrow { margin: 0; font-size: 12px; letter-spacing: .18em; color: var(--trophy); }
  .hero__name { margin: 14px 0 0; font-weight: 900; font-size: clamp(88px, 17.5cqi, 272px); line-height: .8; letter-spacing: -.01em; }
  .hero__tagline { margin: 28px 0 0; max-width: 640px; font-size: clamp(20px, 2.1cqi, 28px); line-height: 1.3; font-weight: 500; }
  .hero__sub { margin: 14px 0 0; font-size: 13px; line-height: 22px; color: var(--muted); }
  .hero__ctas { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__cue {
    position: absolute; left: 50%; bottom: clamp(100px, 10cqi, 140px); transform: translateX(-50%);
    margin: 0; font-size: 11px; letter-spacing: .3em; color: var(--muted); white-space: nowrap;
  }

  /* Mobile (spec §5.1): planet tucks up behind the bar, towers cropped at the edges. */
  @container (max-width: 600px) {
    .hero__planet { top: -70px; right: -40px; }
    .hero__ring { top: 10px; right: -170px; }
    .tower--l { left: -22px; }
    .tower--r { right: -22px; }
  }

  .ticker {
    position: relative; z-index: 3; overflow: hidden; margin: -10px -20px 0;
    background: var(--trophy); color: var(--on-trophy); transform: rotate(-1.2deg);
  }
  .hero__name { transform-origin: 0% 100%; }
  .hero__first, .hero__last, .hero__stop { display: inline-block; }

  .ticker .marquee { gap: 28px; padding: 10px 0; font-weight: 800; font-size: 26px; letter-spacing: .02em; }
</style>
