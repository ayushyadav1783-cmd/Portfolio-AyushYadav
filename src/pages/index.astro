---
import Base from '../layouts/Base.astro';
import BroadcastBar from '../components/BroadcastBar.astro';
import Hero from '../components/Hero.astro';
import WarmUp from '../components/WarmUp.astro';
import StartingVII from '../components/StartingVII.astro';
import PowerUps from '../components/PowerUps.astro';
import FanZone from '../components/FanZone.astro';
import FullTime from '../components/FullTime.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <div class="frame">
    <BroadcastBar />
    <main>
      <Hero />
      <WarmUp />
      <StartingVII />
      <PowerUps />
      <FanZone />
      <FullTime />
    </main>
    <Footer />
  </div>
</Base>
